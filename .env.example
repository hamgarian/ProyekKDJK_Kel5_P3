# Salin ke .env lalu sesuaikan:  cp .env.example .env
#
# JANGAN commit file .env. Jangan menaruh password/token apa pun di repo ini.
# Password root awal GitLab dibaca dari dalam container setelah boot pertama
# (lihat README.md bagian Pemakaian), bukan diset dari file ini.

# Hostname yang dipakai container dan reverse proxy.
GITLAB_HOST=gitlab.ilhem.eu.org

# URL eksternal lengkap. Harus cocok dengan hostname di reverse proxy.
GITLAB_EXTERNAL_URL=https://gitlab.ilhem.eu.org

# Port HTTP internal container, di-bind ke 127.0.0.1 saja.
GITLAB_HTTP_PORT=8929

# Port SSH publik untuk git clone (22 biasanya sudah dipakai sshd host).
GITLAB_SSH_PORT=2222

# Batas ukuran upload.
GITLAB_MAX_ATTACHMENT_MB=50
GITLAB_MAX_BODY_SIZE=50m

# Retensi backup dalam detik (604800 = 7 hari).
GITLAB_BACKUP_KEEP_TIME=604800
